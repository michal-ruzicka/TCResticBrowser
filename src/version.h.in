#ifndef RESTIC_WFX_VERSION_H
#define RESTIC_WFX_VERSION_H

/*
 * Generated by CMake from version= in src/pluginst.inf, the single source of truth for the plugin
 * version. Edit pluginst.inf, never the generated build/<arch>/version.h.
 */
#define RESTIC_WFX_VER_MAJOR      @RESTIC_WFX_VER_MAJOR@
#define RESTIC_WFX_VER_MINOR      @RESTIC_WFX_VER_MINOR@
#define RESTIC_WFX_VER_PATCH      @RESTIC_WFX_VER_PATCH@
#define RESTIC_WFX_VER_BUILD      0

#define RESTIC_WFX_VERSION_CSV    @RESTIC_WFX_VER_MAJOR@,@RESTIC_WFX_VER_MINOR@,@RESTIC_WFX_VER_PATCH@,0
#define RESTIC_WFX_VERSION_STR    "@RESTIC_WFX_VER_MAJOR@.@RESTIC_WFX_VER_MINOR@.@RESTIC_WFX_VER_PATCH@.0"
#define RESTIC_WFX_PRODUCT_VER    "@RESTIC_WFX_VERSION@"  /* as in pluginst.inf, e.g. "2.0.0-devel" */

/* restic.wfx (32-bit) or restic.wfx64 (64-bit): the name Total Commander requires per bitness */
#define RESTIC_WFX_FILE_NAME      "@RESTIC_WFX_FILE_NAME@"

#endif /* RESTIC_WFX_VERSION_H */
