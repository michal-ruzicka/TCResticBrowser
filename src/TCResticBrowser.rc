/*
 * Windows Resource Script for Restic Total Commander WFX Plugin (TCResticBrowser.wfx / TCResticBrowser.wfx64)
 *
 * 1. Icon resource (ID 1): Total Commander loads the FIRST icon resource (by index)
 *    found in the WFX DLL and displays it next to "TCResticBrowser" in Network Neighborhood.
 * 2. Version resource (VS_VERSION_INFO): displayed in Windows Explorer / Total Commander
 *    file properties ("Details" tab).
 * 3. The dialog naming the folder of a file's versions (IDD_VERSIONS_FOLDER): Total Commander's
 *    own dialogs (RequestProc) offer no button of the plugin's choosing.
 */

/* UTF-8 source: the copyright notice below contains non-ASCII characters */
#pragma code_page(65001)

#include <windows.h>
#include "version.h"
#include "resource.h"

1 ICON "TCResticBrowser.ico"

/*
 * The path wraps in the multi-line field; the caption ("Versions of <file>") is set at run time.
 * Segoe UI 9 is the message font of Windows since Vista ("MS Shell Dlg" 8 maps to the smaller
 * Tahoma 8); the dialog's size in dialog units grows with it, and with the DPI the dialog is
 * created for (see show_versions_folder() in main.c). Copy to clipboard is what the dialog is
 * for, so it is the default button, first, as Windows places a dialog's commit button.
 */
IDD_VERSIONS_FOLDER DIALOGEX 0, 0, 320, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Versions"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "The versions of this file are listed in this folder:", -1, 7, 7, 306, 10
    EDITTEXT        IDC_VERSIONS_PATH, 7, 20, 306, 46, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    DEFPUSHBUTTON   "&Copy to clipboard", IDC_VERSIONS_COPY, 183, 75, 76, 14
    PUSHBUTTON      "OK", IDOK, 263, 75, 50, 14
END

#ifdef _DEBUG
#define VER_FILEFLAGS VS_FF_DEBUG
#else
#define VER_FILEFLAGS 0x0L
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RESTIC_WFX_VERSION_CSV
PRODUCTVERSION  RESTIC_WFX_VERSION_CSV
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_FILEFLAGS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Michal Růžička Hobby Development\0"
            VALUE "FileDescription",  "TCResticBrowser – Restic backup browser for Total Commander (WFX)\0"
            VALUE "FileVersion",      RESTIC_WFX_VERSION_STR "\0"
            VALUE "InternalName",     RESTIC_WFX_FILE_NAME "\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Pietro Partescano, 2026 Michal Růžička. Licensed under the MIT License.\0"
            VALUE "OriginalFilename", RESTIC_WFX_FILE_NAME "\0"
            VALUE "ProductName",      "TCResticBrowser\0"
            VALUE "ProductVersion",   RESTIC_WFX_PRODUCT_VER "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
